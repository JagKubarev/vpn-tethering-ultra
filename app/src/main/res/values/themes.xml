<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light: страница по prefers-color-scheme берёт светлую тему (WebView смотрит isLightTheme темы) -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <!-- Android 8.0: светлой полосы навигации ещё нет (windowLightNavigationBar с 8.1, values-v27) —
             кнопки белые, поэтому полоса остаётся тёмной по умолчанию -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
