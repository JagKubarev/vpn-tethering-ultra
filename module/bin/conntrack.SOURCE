  libnetfilter_cttimeout-1.0.1.tar.bz2  0b59da2f3204e1c80cb85d1f6d72285fc07b01a2f5678abf5dccfbbefd650325
  libnetfilter_cthelper-1.0.1.tar.bz2   14073d5487233897355d3ff04ddc1c8d03cc5ba8d2356236aa88161a9f2dc912
  libnetfilter_queue-1.0.5.tar.bz2      f9ff3c11305d6e03d81405957bdc11aea18e0d315c3e3f48da53a24ba251b9f5
  libtirpc-1.3.4.tar.bz2 (только armv7) 1e0b0c7231c5fa122e06c0609a76723664d068b0dba3b8219b63e6340b347860
libc: glibc из libc6-dev-arm64-cross / libc6-dev-armhf-cross (Ubuntu 24.04), LGPL-2.1+.

Сборка (arm64: CC=aarch64-linux-gnu-gcc HOST=aarch64-linux-gnu CFLAGS=-Os;
        armv7: CC=arm-linux-gnueabihf-gcc HOST=arm-linux-gnueabihf
               CFLAGS="-Os -march=armv7-a -mfpu=vfpv3-d16"):
  # библиотеки по порядку: libmnl, libnfnetlink, libnetfilter_conntrack,
  # libnetfilter_cttimeout, libnetfilter_cthelper, libnetfilter_queue (+ libtirpc --disable-gssapi для armv7)
  ./configure --host=$HOST --prefix=$SYSROOT --enable-static --disable-shared CFLAGS="$CFLAGS"
  make && make install
  # conntrack-tools (PKG_CONFIG_LIBDIR=$SYSROOT/lib/pkgconfig)
  arm64: ./configure --host=$HOST --prefix=$SYSROOT --disable-cthelper CFLAGS="$CFLAGS" LDFLAGS=-static
  armv7: ./configure --host=$HOST --prefix=$SYSROOT CFLAGS="$CFLAGS" LDFLAGS=-static
         make; make -C src conntrack LDFLAGS=-all-static
  $HOST-strip src/conntrack
